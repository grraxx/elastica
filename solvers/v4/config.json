{
  "d_bounds": [0.7, 0.9999],
  "phi1_bounds": [-2, 2],
  "phi2_bounds": [-2, 2],
  "solve_phi_symmetry": true,

  "grid_steps": {
    "d": 0.01,
    "phi1": 0.01,
    "phi2": 0.01
  },
  "scale_parameters_for_mesh": true,
  "output_mesh": "solution_space.msh",
  "output_npz": "solution_space.npz",

  "beam_elements": 100,
  "snes_rtol": 1e-10,
  "snes_atol": 1e-12,

  "visualization_interval": 50000,
  "progress_interval": 1000,
  "verbose_solves": false,
  "save_theta": true,

  "live_results_npz": "solution_space_live.npz",
  "output_vtu": "solution_space_results.vtu",
  "live_output_vtu": "solution_space_live.vtu",

  "mac_threshold": 0.85,

  "cold_start": {
    "d": 0.9,
    "phi1": 0.4, 
    "phi2": -0.4
  }
}
